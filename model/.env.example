# 학습 서버가 읽는 설정. scripts/local.sh init 이 model/.env 로 복사한다

# ---------- 데이터 반입용 (scripts/local.sh fetch-data 를 실행할 때만 필요) ----------
# 팀 데이터셋이 있는 오브젝트 스토리지 버킷의 접근 키. 반입이 끝나면 비워도 된다
# 버킷 주소와 이름은 model/common.yaml 에 있고, 바꾸려면 OBJECT_STORAGE_ENDPOINT, OBJECT_STORAGE_REGION, OBJECT_STORAGE_BUCKET 을 추가
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
