# 모델 학습 설정 예시 (이상치 모델 · 분류 모델 공통)
# 사용법: cp .env.example .env  →  model/.env 하나를 두 모델 폴더가 함께 읽습니다
# (.env 는 Git에 올리지 않습니다)

# ── 학습 데이터 (비공개 S3 호환 버킷) ──
# NHN 콘솔 > Object Storage > S3 API 자격 증명
OBJECT_STORAGE_ACCESS_KEY=YOUR_NHN_ACCESS_KEY
OBJECT_STORAGE_SECRET_KEY=YOUR_NHN_SECRET_KEY

# ── 실험 기록 ──
# MLflow 서버 주소. Private 서브넷의 MLflow는 SSH 터널을 연 뒤 127.0.0.1 로 접속
# 비우면 common.yaml 의 MLFLOW_TRACKING_URI 값을 씁니다
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# ── GPU 재학습 API 서버 전용 (gpu_training_api.py) ──
# 서비스 .env 의 GPU_TRAINING_TOKEN 과 같은 값
GPU_TRAINING_TOKEN=
# 학습에 쓸 파이썬 경로 (기본값: ~/miniforge3/envs/defect/bin/python)
# GPU_TRAINING_PYTHON=
