# 로컬 실행용 nginx 설정. 운영 설정(infra/service/nginx/default.conf)과 같은 경로 · 인증 흐름을 쓰고, 아래만 다르다.
#   - HTTPS 대신 HTTP(80): localhost 는 브라우저가 안전한 주소로 취급해 로그인 쿠키(Secure)가 그대로 동작한다
#   - resolver: Docker 고정 주소(127.0.0.11) 대신 컨테이너의 DNS 주소를 시작할 때 채운다 (Podman 네트워크 DNS 도 동작)
#   - 전달 대상: compose 서비스 이름(api, grafana-auth-backend) 대신 app 계층 Pod 이름(ksdd2-app)
# 이 파일은 nginx 공식 이미지가 시작할 때 환경변수를 채워 /etc/nginx/conf.d/default.conf 로 만든다.
server {
    listen 80;
    server_name _;

    client_max_body_size 6m;

    # app 계층 주소를 컨테이너 DNS 로 다시 조회한다 (app Pod 를 다시 띄워 주소가 바뀌어도 따라가게)
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # HTML 화면 제공
    location / {
        root /usr/share/nginx/html;
        index zerodefect-ui.html;
    }

    # FastAPI로 요청 전달
    location /api/ {
        set $api_upstream ksdd2-app:8000;

        # /api/ready → /ready
        # /api/predict → /predict
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    # Grafana 하위 경로를 Grafana 컨테이너로 전달
    location = /_internal/grafana-auth {
        internal;
        set $grafana_auth_api ksdd2-app:8000;
        proxy_pass http://$grafana_auth_api/auth/grafana-proxy;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location = /api/auth/grafana-proxy {
        return 404;
    }

    location /grafana/ {
        auth_request /_internal/grafana-auth;
        auth_request_set $grafana_user $upstream_http_x_defectcatch_user;
        proxy_set_header X-WEBAUTH-USER $grafana_user;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";

        set $grafana_upstream ksdd2-app:3000;
        proxy_pass http://$grafana_upstream;

        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
