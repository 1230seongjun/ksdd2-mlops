# 로컬 실행용 웹 이미지: 검사 화면(serving/web) + 로컬 nginx 설정
# 빌드 컨텍스트는 저장소 최상단입니다.
#   podman build -f deploy/local/web/Containerfile -t ghcr.io/1230seongjun/ksdd2-mlops/web:latest .
FROM docker.io/library/nginx:stable-alpine
COPY serving/web/ /usr/share/nginx/html/
COPY deploy/local/web/default.conf /etc/nginx/conf.d/default.conf
