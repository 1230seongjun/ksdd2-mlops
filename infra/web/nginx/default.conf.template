server {
    listen 80;
    listen 443 ssl;
    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;
    server_name _;

    client_max_body_size 6m;

    # 컨테이너 DNS 로 api 컨테이너의 IP를 다시 조회한다.
    # 주소는 nginx 이미지가 시작할 때 /etc/resolv.conf 에서 채운다 (Docker 127.0.0.11, Podman 네트워크 게이트웨이)
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    # HTML 화면 제공
    location / {
        root /usr/share/nginx/html;
        index zerodefect-ui.html;
    }

    # FastAPI로 요청 전달
    location /api/ {
        set $api_upstream api:8000;

        # /api/ready → /ready
        # /api/predict → /predict
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass http://$api_upstream;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    # Grafana 하위 경로를 Grafana 컨테이너로 전달
    location = /_internal/grafana-auth {
        internal;
        set $grafana_auth_api api:8000;
        proxy_pass http://$grafana_auth_api/auth/grafana-proxy;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    location = /api/auth/grafana-proxy {
        return 404;
    }

    location /grafana/ {
        auth_request /_internal/grafana-auth;
        auth_request_set $grafana_user $upstream_http_x_defectcatch_user;
        proxy_set_header X-WEBAUTH-USER $grafana_user;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";

        set $grafana_upstream grafana-auth-backend:3000;
        proxy_pass http://$grafana_upstream;

        proxy_set_header Host $host:$server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
