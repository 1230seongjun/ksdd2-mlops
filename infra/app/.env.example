# 애플리케이션 티어 설정. scripts/local.sh init 이 .env 로 복사하고
# CHANGE_ME 는 DB 티어의 비밀번호로, CHANGE_TOKEN 은 무작위 값으로 바꾼다

# ---------- DB 접속 (MLflow 와 API 가 함께 씀) ----------
# 비밀번호는 접속 주소에 그대로 들어가므로 영문·숫자만 쓴다 (init 이 만드는 값은 영문·숫자)
DB_USER=mlflow
DB_PASSWORD=CHANGE_ME

# ---------- 모델 ----------
# MLflow 에 처음 등록하면 버전 1 이 된다. 다른 버전을 쓰려면 숫자만 바꾸고 scripts/local.sh restart-api
MODEL_URI=models:/Zero-Defects/1
CLASSIFIER_MODEL_URI=models:/Zero-Defects-Classifier/1
# 챌린저 모델 (선택). 비워 두면 화면에 나오지 않는다
CHALLENGER_MODEL_URI=
CHALLENGER_CLASSIFIER_MODEL_URI=

# ---------- 학습 서버 ----------
# api 와 trainer 가 같은 값을 쓴다
GPU_TRAINING_TOKEN=CHANGE_TOKEN

# 학습 데이터 폴더 (기본: 레포의 data/). 다른 곳에 두려면 절대 경로로
# DATASET_DIR=/srv/ksdd2-data
