# 실제 값은 서버의 .env에만 넣고 Git에는 올리지 않습니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://localhost/kakao
# Grafana webhook과 같은 값 (예: python3 -c "import secrets;print(secrets.token_urlsafe(32))")
RELAY_TOKEN=
# 카카오 메시지의 '알림 확인' 버튼 링크. 카카오 앱 [제품 링크 관리 > 웹 도메인]에 도메인 등록 필요
ALERT_LINK=https://<서비스 주소>/grafana/alerting/list
