# 불량제로 서비스 스택 설정 예시
# 사용법: cp .env.example .env && chmod 600 .env  (.env 는 Git에 올리지 않습니다)

# ── 운영 당시 배포 스크립트가 자동으로 채운 값 (직접 넣을 필요 없음) ──
# NCR_REGISTRY=   컨테이너 레지스트리 주소 (NHN Container Registry)
# REGISTRY_PATH=  ksdd2-registry  (레지스트리 안의 저장소 이름)
# API_TAG=        배포한 커밋 SHA 앞 7자리

# ── MLflow: 추론 API가 모델을 내려받는 곳 ──
# mlops 인스턴스의 사설 IP (Private 서브넷이라 공인 IP 없음)
MLFLOW_TRACKING_URI=http://<mlops 사설 IP>:5000

# ── 검사 결과·계정 DB (PostgreSQL의 inference DB) ──
# 비워 두면 DB 저장 없이 판정 결과만 돌려줍니다
INFERENCE_DB_HOST=<mlops 사설 IP>
INFERENCE_DB_PORT=5432
INFERENCE_DB_NAME=inference
# 기본 구성은 infra/mlops/.env 의 POSTGRES_USER 와 같은 계정
INFERENCE_DB_USER=<DB 계정>
INFERENCE_DB_PASSWORD=CHANGE_ME

# ── GPU 재학습 서버 (선택) ──
# 비워 두면 관리자 화면의 재학습 버튼만 동작하지 않습니다
GPU_TRAINING_URL=http://<GPU 서버 사설 IP>:<포트>
# GPU 서버 model/.env 의 GPU_TRAINING_TOKEN 과 같은 값
# 생성: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
GPU_TRAINING_TOKEN=

# ── Grafana ──
# 브라우저에서 접속할 Grafana 주소 (Nginx가 /grafana/ 경로로 프록시)
GF_ROOT_URL=https://<서비스 도메인 또는 IP>/grafana/
